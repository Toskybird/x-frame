[Unit]
Description=X-Frame Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=x-frame
Group=x-frame
WorkingDirectory=/opt/x-frame
ExecStart=/opt/x-frame/datamanagementd \
  -socket-path /tmp/x-frame-datamanagement.sock \
  -sqlite-path /var/lib/x-frame/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
