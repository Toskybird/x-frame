# =============================================================================
# Infra-only env (postgres + redis)
# Copy to .env.infra:  copy .env.infra.example .env.infra
# =============================================================================

BIND_HOST=127.0.0.1
TZ=Asia/Shanghai

# PostgreSQL（与 DEV_GUIDE 本地凭据一致，便于本机开发）
POSTGRES_USER=x-frame
POSTGRES_PASSWORD=x-frame
POSTGRES_DB=x-frame
DATABASE_PORT=5432

# Redis（本地开发默认无密码）
REDIS_PORT=6379
REDIS_PASSWORD=
