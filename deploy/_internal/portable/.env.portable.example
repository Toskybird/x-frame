# =============================================================================
# Portable infra (PostgreSQL + Redis) — Windows 绿色版
# Copy to .env.portable:
#   copy deploy\_internal\portable\.env.portable.example deploy\_internal\portable\.env.portable
# =============================================================================

BIND_HOST=127.0.0.1
TZ=Asia/Shanghai

# PostgreSQL（与 DEV_GUIDE / .env.infra 本地凭据一致）
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_USER=x-frame
POSTGRES_PASSWORD=x-frame
POSTGRES_DB=x-frame
DATABASE_PORT=5432

# Redis（本地开发默认无密码）
REDIS_PORT=6379
REDIS_PASSWORD=
